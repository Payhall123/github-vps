{
  "name": "github-vps + local LLM",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "llama.cpp OpenAI-compatible API",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },
  "postCreateCommand": "chmod +x scripts/*.sh",
  "remoteUser": "vscode"
}
